<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.1</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-pinnacle</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-pinnacle.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameInterface.Pinnacle.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.Pinnacle.Client</PackageId>
		<Title>Tgs.GameInterface.Pinnacle.Client</Title>
		<Description>Tgs.GameInterface.Pinnacle.Client</Description>
		<PackageTags>Tgs GameInterface Pinnacle Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.63.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.63.0" />
		<PackageReference Include="Grpc.Tools" Version="2.64.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.7" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="..\Tgs.GameInterface.Pinnacle\Protos\gameinterfacepinnacle.proto" GrpcServices="Client">
	    <Link>gameinterfacepinnacle.proto</Link>
	  </Protobuf>
	</ItemGroup>

</Project>
